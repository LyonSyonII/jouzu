{
  "name": "jouzu",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "dev": "NG_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.44 pnpm ng serve --host 0.0.0.0",
    "build": "ng build -c production",
    "watch": "ng build --watch --configuration development",
    "preview": "pnpm build && pnpx sirv-cli dist/jouzu/browser/ --single --etag --maxage 31536000 --immutable --port 4201 --gzip --brotli",
    "release": "ng deploy --cname=garriga.dev --base-href=/jouzu/",
    "serve:ssr:jouzu": "node dist/jouzu/server/server.mjs",
    "format": "prettier --check --write ."
  },
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "dependencies": {
    "@angular/common": "^21.2.15",
    "@angular/compiler": "^21.2.15",
    "@angular/core": "^21.2.15",
    "@angular/forms": "^21.2.15",
    "@angular/platform-browser": "^21.2.15",
    "@angular/platform-server": "^21.2.15",
    "@angular/router": "^21.2.15",
    "@angular/service-worker": "^21.2.15",
    "@angular/ssr": "^21.2.13",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/noto-sans-jp": "^5.2.10",
    "@primeuix/themes": "^2.0.3",
    "angular-svg-icon": "^19.1.1",
    "arktype": "^2.2.0",
    "core-js": "^3.49.0",
    "fzstd": "^0.1.1",
    "idb-keyval": "^6.2.5",
    "ngx-quicklink": "^0.4.9",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.8",
    "remeda": "^2.37.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.13",
    "@angular/cli": "^21.2.13",
    "@angular/compiler-cli": "^21.2.15",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.41",
    "angular-cli-ghpages": "^3.0.3",
    "express": "^5.2.1",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3",
    "vitest": "^4.1.8"
  }
}
